
    #dcb pfc set dev enp65s0f0np0 prio-pfc all:off 3:on
    
    # Unload bonding module 
    # modprobe -r bonding || true

    #modprobe bonding mode=802.3ad miimon=100 lacp_rate=1 xmit_hash_policy=layer3+4
    ip link add mlnx-bond type bond mode 802.3ad miimon 100 lacp_rate fast xmit_hash_policy layer3+4

    ip link set enp65s0f0np0 down
    ip link set enp65s0f1np1 down

    ip link set enp65s0f0np0 master mlnx-bond
    ip link set enp65s0f1np1 master mlnx-bond

    ip link set enp65s0f0np0 mtu 9000
    ip link set enp65s0f1np1 mtu 9000
    ip link set enp65s0f0np0 up
    ip link set enp65s0f1np1 up
    ip link set mlnx-bond mtu 9000
    ip link set mlnx-bond up

    # KEEPALIVED MGMT
    ip link add link mlnx-bond name keepalived type vlan id 5
    ip link set keepalived up
    ip addr add 4.0.0.11/24 dev keepalived 

